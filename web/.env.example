# --- The Storyteller's Room — Next.js / SSE bridge environment ---
#
# Copy this file to `.env.local` for local dev:
#     cp .env.example .env.local
#
# In production (Cloud Run), the service account credentials are injected
# automatically via the runtime metadata server — no GOOGLE_APPLICATION_CREDENTIALS
# file is needed. For local dev:
#
#     gcloud auth application-default login --quiet
#
# (Charlie's machine already has ADC configured.)

# Required: GCP project for Firestore Admin SDK calls.
GOOGLE_CLOUD_PROJECT=predictive-fx-495200-j4

# Vertex AI region (`global` per HOE-DEC-015 for Gemini 3.x family models).
# Not consumed by the SSE bridge directly, but kept here so the web service's
# env file matches the agent-runtime convention.
GOOGLE_CLOUD_LOCATION=global
